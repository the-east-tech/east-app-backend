  "tag1Id": "{{tagId}}",
  "tag2Id": "{{tag2Id}}",
  "unit": "kg",
  "minimumBalanceValue": 5,
  "maximumBalanceValue": 30,
  "currentBalanceValue": 12,
  "recoveryPercent": 100,
  "minimumPriceRm": 40,
  "maximumPriceRm": 50,
