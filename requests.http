}

### List my stock counts — paged
GET {{baseUrl}}/api/v1/stock/counts?mine=true&from={{fromDate}}&to={{toDate}}&page=0&size=50
Authorization: Bearer {{eastappToken}}

### List review stock counts — paged
GET {{baseUrl}}/api/v1/stock/counts?mine=false&reviewStatus=Pending%20Review&page=0&size=50
Authorization: Bearer {{eastappToken}}

### Submit daily stock count
POST {{baseUrl}}/api/v1/stock/counts
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "skuId": "{{skuId}}",
  "capturedAt": "{{capturedAt}}",
  "stockPhotoName": "stock-count.jpg",
  "invoicePhotoName": "invoice.jpg",
  "currentBalanceValue": 9.5,
  "checkedItems": {
    "Packaging": true,
    "Expiry": true
  },
  "remarks": {
    "General": "Count verified"
  }
}

### Review stock count
PATCH {{baseUrl}}/api/v1/stock/counts/{{countId}}/review
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "status": "Approved",
  "note": "Verified"
}

### List receiving records — paged
GET {{baseUrl}}/api/v1/stock/receivings?reviewStatus=Pending%20Review&page=0&size=50
Authorization: Bearer {{eastappToken}}

### Submit receiving
POST {{baseUrl}}/api/v1/stock/receivings
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "supplierId": "{{supplierId}}",
  "capturedAt": "{{capturedAt}}",
  "invoicePhotoName": "invoice.jpg",
  "goodsPhotoName": "goods.jpg",
  "items": [
    {
      "skuId": "{{skuId}}",
      "invoiceQuantity": 10,
      "receivedQuantity": 10,
      "condition": "Good",
      "note": ""
    }
  ]
}

### Review receiving
PATCH {{baseUrl}}/api/v1/stock/receivings/{{receivingId}}/review
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "status": "Approved",
  "note": "Invoice and goods verified"
}

### Stock audit — full tenant trail for Owner or Head
GET {{baseUrl}}/api/v1/stock/audit?from={{fromDate}}&to={{toDate}}&mine=false&page=0&size=50
Authorization: Bearer {{eastappToken}}

### Stock audit — current logged-in user's five latest activities for Home
GET {{baseUrl}}/api/v1/stock/audit?from={{fromDate}}&to={{toDate}}&mine=true&page=0&size=5
Authorization: Bearer {{eastappToken}}

### Today's combined Daily Count and Receiving review summary — Owner, Head or Manager
GET {{baseUrl}}/api/v1/stock/reviews/today-summary
Authorization: Bearer {{eastappToken}}

### List Knowledge SOPs for active business
GET {{baseUrl}}/api/v1/knowledge/sops?search=&page=0&size=50
Authorization: Bearer {{eastappToken}}

### List Knowledge SOPs by Stock tag
GET {{baseUrl}}/api/v1/knowledge/sops?tagId={{tagId}}&page=0&size=50
Authorization: Bearer {{eastappToken}}

### Get Knowledge SOP
GET {{baseUrl}}/api/v1/knowledge/sops/{{sopId}}
Authorization: Bearer {{eastappToken}}

### Create Knowledge SOP — Owner or Head only
POST {{baseUrl}}/api/v1/knowledge/sops
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "youtubeUrl": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
  "tagId": "{{tagId}}",
  "title": "Belly Pork Preparation",
  "expectedOutcome": "Staff prepare belly pork consistently and safely.",
  "description": "Follow the video and complete each preparation step before service."
}


### Google Places - setup autocomplete (only before initial setup)
GET {{baseUrl}}/api/v1/setup/google-places/autocomplete?query=June%20Coffee
Accept: application/json

### Google Places - setup details (only before initial setup)
GET {{baseUrl}}/api/v1/setup/google-places/{{googlePlaceId}}
Accept: application/json

### Google Places - authenticated autocomplete (Owner/Head)
GET {{baseUrl}}/api/v1/google-places/autocomplete?query=June%20Coffee
Accept: application/json
Authorization: Bearer {{eastappToken}}

### Google Places - authenticated details (Owner/Head)
GET {{baseUrl}}/api/v1/google-places/details/{{googlePlaceId}}
Accept: application/json
Authorization: Bearer {{eastappToken}}

### Google rating for current business
GET {{baseUrl}}/api/v1/google-places/current-rating
Accept: application/json
Authorization: Bearer {{eastappToken}}

### Current-business leaderboard — active users only; competition ranking for ties
GET {{baseUrl}}/api/v1/points/leaderboard
Authorization: Bearer {{eastappToken}}

### Add points — Owner or Head only; pointsDelta must be 1 to 10
POST {{baseUrl}}/api/v1/points/adjustments
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "userId": "{{userId}}",
  "pointsDelta": 1,
  "reason": "Helped the team during peak service"
}

### Deduct points — Owner or Head only; pointsDelta must be -1 to -10
POST {{baseUrl}}/api/v1/points/adjustments
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "userId": "{{userId}}",
  "pointsDelta": -1,
  "reason": "Repeatedly missed the agreed closing checklist"
}


### Report dashboard — current business; staff responses are privacy-reduced
GET {{baseUrl}}/api/v1/reports/dashboard?days=7
Authorization: Bearer {{eastappToken}}

### Upload report evidence photo
POST {{baseUrl}}/api/v1/reports/media
Authorization: Bearer {{eastappToken}}
Content-Type: multipart/form-data; boundary=EastAppReportBoundary

--EastAppReportBoundary
Content-Disposition: form-data; name="file"; filename="report-photo.jpg"
Content-Type: image/jpeg

< {{reportPhotoFile}}
--EastAppReportBoundary--

### Download report evidence photo for the active business
GET {{baseUrl}}/api/v1/reports/media/{{reportMediaKey}}
Authorization: Bearer {{eastappToken}}
Accept: image/jpeg,image/png

### Read daily Sales report — management only
GET {{baseUrl}}/api/v1/reports/sales?date={{reportDate}}
Authorization: Bearer {{eastappToken}}

### Create or update daily Sales report — management only
PUT {{baseUrl}}/api/v1/reports/sales
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "reportDate": "{{reportDate}}",
  "cashTotalRm": 1200.00,
  "cashReceivedBy": "KK",
  "foodDeliverySalesRm": 450.00,
  "ewalletTotalRm": 380.00,
  "staffOnDuty": 6
}

### Add Void Bill — any active user; photo key must belong to the logged-in uploader
POST {{baseUrl}}/api/v1/reports/sales/void-bills
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "reportDate": "{{reportDate}}",
  "billNumber": "VOID-001",
  "reason": "Wrong item entered",
  "amountRm": 18.50,
  "photoStorageKey": "{{reportMediaKey}}"
}

### Submit Sales report for approval — management only
POST {{baseUrl}}/api/v1/reports/sales/{{reportId}}/submit
Authorization: Bearer {{eastappToken}}

### Create Waste report — any active user
POST {{baseUrl}}/api/v1/reports/waste
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "reportDate": "{{reportDate}}",
  "skuId": "{{skuId}}",
  "itemName": "Fallback item name",
  "quantity": 2.5,
  "unit": "kg",
  "estimatedUnitCostRm": 12.00,
  "reason": "Expired during service",
  "photoStorageKey": "{{reportMediaKey}}"
}

### List Waste reports
GET {{baseUrl}}/api/v1/reports/waste?from={{fromDate}}&to={{toDate}}
Authorization: Bearer {{eastappToken}}

### Read Daily Photos — omit userId for own batch; management may specify a user
GET {{baseUrl}}/api/v1/reports/daily-photos?date={{reportDate}}&userId={{userId}}
Authorization: Bearer {{eastappToken}}

### Add Daily Photo — photo key must belong to the logged-in uploader
POST {{baseUrl}}/api/v1/reports/daily-photos
Authorization: Bearer {{eastappToken}}
Content-Type: application/json

{
  "reportDate": "{{reportDate}}",
  "photoStorageKey": "{{reportMediaKey}}"
}

### Submit Daily Photo batch after minimum evidence count
POST {{baseUrl}}/api/v1/reports/daily-photos/{{reportId}}/submit
Authorization: Bearer {{eastappToken}}

